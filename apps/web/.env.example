# Tom Tom API
NUXT_PUBLIC_TOMTOM_POI_CATEGORIES_URL='https://api.tomtom.com/search/2/poiCategories'

# Place bias is used to communicate a location preference to the search engine (Trójmiasto geobias)
NUXT_PUBLIC_TOMTOM_RECTANGLE_GEOBIAS='topLeftLat,topLeftLon,btmRightLat,btmRightLon'
NUXT_PUBLIC_TOMTOM_FUZZY_SEARCH_RESPONSES_LIMIT='7'

NUXT_PUBLIC_TOMTOM_API_KEY='<API_KEY>'
